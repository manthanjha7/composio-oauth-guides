# Required for live guide generation (the library works without it)
ANTHROPIC_API_KEY=
# Optional: research via Composio Search + managed-auth status from the toolkit API.
# Without it the agent uses Anthropic web search and Composio's public docs.
COMPOSIO_API_KEY=
# Optional: durable storage for generated guides on Vercel (Vercel Blob). Without it guides are written to ./.data (local dev only).
BLOB_READ_WRITE_TOKEN=
# Optional tuning
AGENT_MODEL=claude-sonnet-5-5
AGENT_RESEARCH_MODEL=claude-haiku-5-5
AGENT_EFFORT=medium
GENERATE_PER_IP_PER_HOUR=6
GENERATE_DAILY_CAP=60
