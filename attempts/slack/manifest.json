{
  "display_information": {
    "name": "Agent Setup Test",
    "description": "Test app for an AI agent that reads channels and posts replies.",
    "background_color": "#4f46e5"
  },
  "features": {
    "bot_user": {
      "display_name": "agent-setup-test",
      "always_online": false
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "https://backend.composio.dev/api/v3/toolkits/auth/callback"
    ],
    "scopes": {
      "bot": [
        "chat:write",
        "channels:read",
        "channels:history"
      ],
      "user": [
        "chat:write",
        "channels:read",
        "channels:history"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
