{
  "_about": "Category test set. Expected labels come from the 86-provider categorisation study (Haiku readers of public docs, mostly medium confidence) and our own research; treat as directional ground truth. path: any scenario's confirmed path must be in the set. modifiers: each kind must appear on some scenario. must: regexes over sourced claims.",
  "apps": [
    { "app": "OpenWeather", "category": "Not OAuth", "outcome": "not_oauth" },
    { "app": "Todoist", "category": "Automatic / self-serve", "path": ["automatic", "self_serve"], "must": [["OAuth app registration in the console", "app console|developer console|client id|register"]] },
    { "app": "Harvest", "category": "Self-serve", "path": ["self_serve"], "must": [["OAuth2 application in Harvest ID / developers", "Harvest ID|developers|OAuth2? application"]] },
    { "app": "Help Scout", "category": "Self-serve", "path": ["self_serve"], "must": [["create an app under My Apps", "My Apps|create (an )?app"]] },
    { "app": "Kintone", "category": "Self-serve + customer admin", "path": ["self_serve"], "modifiers": ["customer_admin"], "must": [["OAuth client added by each customer's administrator", "administrator|admin"]] },
    { "app": "Intercom", "category": "App review (always) + limited before approval", "path": ["app_review"], "modifiers": ["limited_before_approval"], "must": [["approval before other workspaces install", "review|approv"], ["private until approved", "own workspace|private|development workspace|only.*workspace"]] },
    { "app": "Zendesk", "category": "App review + customer admin", "path": ["app_review"], "must": [["global OAuth client needs Zendesk approval", "global (OAuth )?client|request|review"]] },
    { "app": "Gmail", "category": "App review (sensitive scopes) + recurring", "path": ["app_review"], "modifiers": ["recurring"], "must": [["100 test users in Testing", "100 (test )?users|up to 100"], ["7-day expiry in Testing", "7[- ]days?|seven[- ]days?"], ["restricted scopes need a security assessment", "security assessment|CASA"]] },
    { "app": "YNAB", "category": "App review (scale trigger) + limited before approval", "path": ["app_review", "self_serve"], "modifiers": ["limited_before_approval"], "must": [["25-user restricted mode", "\\b25\\b"]] },
    { "app": "Gusto", "category": "Partner acceptance", "path": ["partner"], "must": [["production pre-approval / partners only", "pre-approval|partner|security review"]] },
    { "app": "Greenhouse", "category": "Partner acceptance", "path": ["partner"], "must": [["signed partnership agreement", "partner(ship)? agreement|partner"]] },
    { "app": "Clover", "category": "Partner + app review (stacked)", "path": ["partner", "app_review"], "must": [["app approval before merchants install", "approv|review"]] },
    { "app": "Slack", "category": "App review + threshold to list", "path": ["app_review"], "modifiers": ["threshold"], "must": [["active workspaces before listing", "\\b(5|10|five|ten) (or more )?(active )?workspaces"], ["unlisted apps rate-limited", "1 request|one request|per minute|rate.limit"]] },
    { "app": "X (Twitter)", "category": "Paid access", "path": ["self_serve", "app_review"], "modifiers": ["paid_access"], "must": [["paid / pay-per-use API access", "pay|paid|credits|pricing"]] },
    { "app": "ServiceNow", "category": "Customer creates the integration", "path": ["self_serve", "app_review"], "modifiers": ["customer_admin"], "must": [["customer admin registers the OAuth app on their instance", "application registry|instance|admin"]] },
    { "app": "SurveyMonkey", "category": "App review + use restrictions", "path": ["app_review"], "modifiers": ["use_restrictions"], "must": [["public apps need approval", "approv|review"]] },
    { "app": "Box", "category": "Self-serve + customer admin (optional listing review)", "path": ["self_serve", "app_review"], "modifiers": ["customer_admin"], "must": [["admin enablement if inactive", "enabl|inactive"], ["admin authorization is for JWT/CCG apps", "JWT|Client Credentials|server authentication"]] },
    { "app": "Xero", "category": "Partner / certification + connection limits", "path": ["partner", "app_review"], "must": [["connection limits", "connection|uncertified"], ["security assessment above 1,000 connections", "1,?000 connections|security (self-)?assessment"], ["certification / partner program", "certif|partner"]] }
  ]
}
